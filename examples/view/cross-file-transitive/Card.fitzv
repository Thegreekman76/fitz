// v0.26.0 — cross-file composition, transitive + alias. This is the
// MIDDLE component. `App.fitzv` imports it aliased (`from Card import
// Card as Row`) and composes it as `<Row />`; the renamed clone the
// loader registers under `Row` carries this whole surface.
//
// Card in turn composes `<Badge />` — a component in yet ANOTHER file
// (`Badge.fitzv`) that App does NOT import. The transitive import walk
// discovers it via this file's `from Badge import Badge`, so `<Badge />`
// resolves and its emit is inlined too.

from Badge import Badge

component Card {
  state {
    title: Str = "Untitled"
    likes: Int = 0
  }

  event like() {
    likes = likes + 1
  }

  <template>
    <article class="card">
      <header class="head">
        <Badge label="peak" />
        <h2 class="title">{title}</h2>
      </header>
      <button class="like" @click="like">♥ {likes}</button>
    </article>
  </template>

  <style scoped>
    .card { border: 1px solid #ddd; border-radius: 10px; padding: 12px 14px; background: #fff; display: flex; flex-direction: column; gap: 8px; }
    .head { display: flex; align-items: center; gap: 8px; }
    .title { margin: 0; font-size: 1.05em; }
    .like { align-self: flex-start; padding: 5px 10px; cursor: pointer; border: 1px solid #c33; border-radius: 6px; background: #fff; color: #c33; }
  </style>
}
