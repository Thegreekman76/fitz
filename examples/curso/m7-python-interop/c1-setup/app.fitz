// examples/curso/m7-python-interop/c1-setup/app.fitz
// Cap 7.C1 — primer programa con interop Python.
//
// Combina math + json + datetime con un handler HTTP.
//
// Setup:
//   python3 -m venv venv && source venv/bin/activate
//   cargo build --release --features python
//
// Run:
//   source venv/bin/activate
//   fitz run app.fitz
//
// Probar:
//   curl localhost:3000/circle/5.0
//   curl localhost:3000/timestamp
//   curl localhost:3000/echo

from python import math
from python import json
from python import datetime

@get("/circle/{radius}")
fn circle_area(radius: Float) -> Map<Str, Any> {
    // math.pi es PyAny — la anotación `let pi: Float = ...`
    // dispara la coerción auto-primitive PyAny → Float (Fase 8.4).
    let pi: Float = math.pi
    let area = pi * radius * radius
    let circumference = 2.0 * pi * radius
    return {
        "radius": radius,
        "area": area,
        "circumference": circumference
    }
}

@get("/timestamp")
fn timestamp() -> Result<Map<Str, Any>> {
    // Toda call Python se envuelve en Result<T> (Fase 8.3).
    // `?` propaga el Err si el call Python explota.
    // El handler retorna Result<Map<Str, Any>> para poder usar `?`.
    let now = datetime.datetime.now()?
    let iso = now.isoformat()?
    return Ok({
        "iso": iso
    })
}

@get("/echo")
fn echo() -> Result<Str> {
    // json.dumps(payload) devuelve Result<Str> automático.
    // El handler retorna Result<Str> para propagar con return directo.
    let payload = {"app": "demo-python-interop", "version": "v1.0"}
    return json.dumps(payload)
}

@server(3000)
fn main() => 0
