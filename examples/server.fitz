// server.fitz — full REST API in Fitz.
//
// Phase 4 success criterion: this file runs end-to-end with
// `fitz run examples/server.fitz` and answers the following requests
// with the correct responses:
//
//   curl http://127.0.0.1:3000/
//   curl http://127.0.0.1:3000/users
//   curl http://127.0.0.1:3000/users/1
//   curl http://127.0.0.1:3000/users/99
//   curl -X POST http://127.0.0.1:3000/users \
//        -H "Content-Type: application/json" \
//        -d '{"name":"sofi","email":"sofi@x.com"}'
//   curl -X PUT http://127.0.0.1:3000/users/1 \
//        -H "Content-Type: application/json" \
//        -d '{"name":"ana updated","email":"ana2@x.com"}'
//   curl -X DELETE http://127.0.0.1:3000/users/2
//
// The features that the syntax-spec previews (custom status codes
// like `return 201 user` or `return 404 { ... }`) are not implemented
// yet — that part of the syntax-spec is direction, not contract.
// What we do have:
//   - Ok(v)  → 200 with v serialized
//   - Err(e) → 500 with {"error": e}
//   - Any other Value → 200 directly

@server(3000)
fn main() => 0

type User {
    id: Int
    name: Str
    email: Str?
}

type UserInput {
    name: Str
    email: Str?
}

// In-memory "database": a `List<User>` that lives in the top-level
// env. Since `List` is Rc<RefCell<>>, every handler shares the same
// instance, and mutations (push, field mutations) are visible across
// requests.
let users = [
    User { id: 1, name: "ana", email: "ana@x.com" },
    User { id: 2, name: "luis", email: null },
]

// Return annotations are required by `fitz build` (debt 5b.1 —
// codegen type inference pending). In `fitz run` the interpreter
// still infers them; the compilable subset is stricter.

@get("/")
fn index() -> Str => "Fitz API running 🏔️"

@get("/users")
fn list_users() -> List<User> => users

@get("/users/{id}")
fn get_user(id: Int) -> Result<User> {
    let found = users.find(fn(u) => u.id == id)
    return match found {
        Ok(u)  => Ok(u)
        Err(_) => Err("user {id} not found")
    }
}

@post("/users")
fn create_user(body: UserInput) -> User {
    let new_id = users.len() + 1
    let u = User { id: new_id, name: body.name, email: body.email }
    users.push(u)
    return u
}

// Update: if the user exists, we mutate its fields and return it.
// If not, Err → 500. We use `?` to unwrap the Ok and let the
// Err propagate up to the caller (handler → runtime → 500).
@put("/users/{id}")
fn update_user(id: Int, body: UserInput) -> Result<User> {
    let u = users.find(fn(u) => u.id == id)?
    u.name = body.name
    u.email = body.email
    return Ok(u)
}

// Delete: filter and rebuild the list to preserve the shared
// reference the other handlers see.
@delete("/users/{id}")
fn delete_user(id: Int) -> Result<Str> {
    let exists = users.find(fn(u) => u.id == id)
    return match exists {
        Err(_) => Err("user {id} not found")
        Ok(_)  => do_delete(id)
    }
}

fn do_delete(id: Int) -> Result<Str> {
    let kept = users.filter(fn(u) => u.id != id)
    while (users.len() > 0) {
        users.pop()
    }
    for u in kept {
        users.push(u)
    }
    return Ok("user {id} deleted")
}
