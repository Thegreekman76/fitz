// 04-operadores.fitz — Aritmética, comparación e igualdad.

// Aritmética entre Int — el resultado también es Int.
print(2 + 3)
print(10 - 4)
print(6 * 7)
print(10 / 3)     // 3 — división entera (ambos son Int)

// Con Float — el resultado es Float.
print(10.0 / 3.0)

// Mezclar Int y Float promueve a Float.
print(1 + 1.0)
print(10 / 3.0)

// Unario negativo.
print(-5)
let x = 10
print(-x)

// Módulo (R.1.2 mini-fase R). Solo entre Int. Semántica euclidean.
print(10 % 3)        // 1
print(12 % 4)        // 0
print(-7 % 3)        // 2 (NO -1 — euclidean, mismo signo del divisor)
if (x % 2 == 0) {
    print("x es par")
}

// Comparación.
print(1 < 2)
print(3 >= 3)
print("a" < "b")    // strings se comparan lexicográficamente

// Igualdad.
print(1 == 1)
print(1 == 1.0)     // Int y Float numéricamente iguales
print(null == null)
// `1 == "1"` también funciona en el intérprete (devuelve false porque
// los tipos son distintos), pero el compilador (`fitz build`) rechaza
// la comparación entre Int y Str directamente — Rust exige operandos
// del mismo tipo para `==`. Si querés probarlo, corré este archivo
// con `fitz run`.

// --- Operadores compuestos (R.2.3, mini-fase R) ---
// `+=`, `-=`, `*=`, `/=` aplican la operación al destino. Se desugar
// a `target = target <op> rhs` en el parser, así que valen sobre
// cualquier destino de asignación: identificador, campo (`obj.x`),
// índice (`xs[0]`).
let total = 0
total += 5
total += 10
total -= 2
total *= 3
total /= 2
print(total)           // 19

let xs = [10, 20, 30]
xs[0] += 100
xs[2] *= 2
print(xs)              // [110, 20, 60]

// Patrón típico: acumular adentro de un loop.
let suma = 0
for i in 1..=5 {
    suma += i
}
print(suma)            // 15
