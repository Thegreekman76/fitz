// cap 31 (avanzado) — CRUD HTTP completo con ORM nativo + Postgres.
//
// Showcase del stack web first-class del lado server:
//   HTTP nativo (cap 17) + body deserialization +
//   ORM declarativo (cap 31) + relations + preload + JSONB +
//   chain dinámico + env vars (cap 32) + @server config.
//
// Cero deps externas: el driver Postgres + el ORM viven en el
// binario `fitz`. `fitz build` produce un .exe/ELF/Mach-O
// standalone que habla wire protocol v3.0 sin libpq.
//
// Setup pre-condición para correr el binario:
//
//   1. Postgres real corriendo (default: localhost:5432, db `fitz_demo`).
//   2. Var de entorno DATABASE_URL (opcional — default abajo).
//   3. Crear las tablas con el schema de abajo:
//
//      CREATE TABLE users (
//        id bigserial PRIMARY KEY,
//        email text NOT NULL UNIQUE,
//        name text NOT NULL
//      );
//      CREATE TABLE posts (
//        id bigserial PRIMARY KEY,
//        title text NOT NULL,
//        body text NOT NULL,
//        user_id bigint NOT NULL REFERENCES users(id) ON DELETE CASCADE,
//        metadata jsonb NOT NULL DEFAULT '{}'::jsonb
//      );
//
//   $ createdb fitz_demo
//   $ export DATABASE_URL="postgres://postgres:postgres@localhost/fitz_demo?sslmode=disable"
//   $ fitz build examples/guide/31b-orm-crud-http.fitz
//   $ ./31b-orm-crud-http
//
// Si NO hay Postgres real, el binario falla al boot con error de
// conexión claro. La compilación con `fitz build` es independiente
// — el codegen del ORM se valida en compile-time sin tocar DB.
//
// Endpoints expuestos:
//
//   GET    /                          — health check
//   GET    /users                     — lista todos
//   GET    /users/{id}                — uno por id
//   POST   /users                     — crea (body: UserInput)
//   PUT    /users/{id}                — actualiza (body: UserInput)
//   DELETE /users/{id}                — borra
//   GET    /users/{id}/posts          — posts del user (relation query)
//   POST   /posts                     — crea post (body: PostInput)
//   GET    /users-with-posts          — preload HasMany (cierra N+1)
//   GET    /posts-with-author         — preload BelongsTo (v0.10.5)
//   GET    /posts/drafts              — JSON op .has_key (v0.10.5)
//   GET    /posts/by-lang/{lang}      — JSON op .get(...)=var (v0.10.5)
//   POST   /posts/search              — chain dinámico (v0.10.5)
//   GET    /user-count                — aggregate scalar
//   GET    /stats/by-email            — GROUP BY aggregate

// --- 1. Tipos ORM con relations + companion + JSONB ----------------

@table("users") type User {
    @primary id: Int = 0
    email: Str
    name: Str
    @has_many("Post", via="user_id") posts: List<Post>
}

@table("posts") type Post {
    @primary id: Int = 0
    title: Str
    body: Str
    @belongs_to("User") user_id: Int

    // Deuda #2 (v0.10.5) — companion field auto-detectado por el
    // checker (strip `_id` del FK + match con sibling Nullable<Target>).
    // Habilita `Post.preload("user")` con batch SELECT inverso.
    user: User?

    // Deuda #3 (v0.10.5) — JSONB field. Habilita .has_key/.get/etc
    // adentro de `.where(...)`. Mapeado a `jsonb` column.
    metadata: Map<Str, Any>
}

// --- 2. Body shapes (entradas HTTP separadas del shape DB) -----------

type UserInput { email: Str, name: Str }
type PostInput { title: Str, body: Str, user_id: Int, metadata: Map<Str, Any> }
type SearchInput { lang: Str, min_id: Int, drafts_only: Bool }

// --- 3. Helper de conexión: lee DATABASE_URL con default ------------

async fn open_db() -> Result<DbConn> {
    let url = env_or("DATABASE_URL", "postgres://postgres:postgres@localhost/fitz_demo?sslmode=disable")
    return db.connect(url).await
}

// --- 4. Handlers HTTP --------------------------------------------------

@server(31980)
fn main() => 0

@get("/")
fn index() -> Str => "Fitz CRUD ORM corriendo 🏔️"

@get("/users")
async fn list_users() -> Result<List<User>> {
    let conn = open_db().await?
    return User.all(conn).await
}

@get("/users/{id}")
async fn get_user(id: Int) -> Result<User> {
    let conn = open_db().await?
    return User.where(fn(u) => u.id == id).first(conn).await
}

@post("/users")
async fn create_user(body: UserInput) -> Result<User> {
    let conn = open_db().await?
    let u = User { id: 0, email: body.email, name: body.name, posts: [] }
    return User.insert(conn, u).await
}

@put("/users/{id}")
async fn update_user(id: Int, body: UserInput) -> Result<Int> {
    let conn = open_db().await?
    return User.where(fn(u) => u.id == id)
        .update(conn, {"email": body.email, "name": body.name})
        .await
}

@delete("/users/{id}")
async fn delete_user(id: Int) -> Result<Int> {
    let conn = open_db().await?
    return User.where(fn(u) => u.id == id).delete(conn).await
}

@get("/users/{id}/posts")
async fn list_user_posts(id: Int) -> Result<List<Post>> {
    let conn = open_db().await?
    return Post.where(fn(p) => p.user_id == id).all(conn).await
}

@post("/posts")
async fn create_post(body: PostInput) -> Result<Post> {
    let conn = open_db().await?
    let p = Post {
        id: 0,
        title: body.title,
        body: body.body,
        user_id: body.user_id,
        user: null,
        metadata: body.metadata
    }
    return Post.insert(conn, p).await
}

@get("/users-with-posts")
async fn users_with_posts() -> Result<List<User>> {
    // Eager loading HasMany: 1 query batch para users + 1 query
    // batch para TODOS los posts (WHERE user_id IN (...)).
    let conn = open_db().await?
    return User.preload("posts").all(conn).await
}

@get("/posts-with-author")
async fn posts_with_author() -> Result<List<Post>> {
    // Deuda #2 (v0.10.5) — Eager loading BelongsTo via companion.
    // 1 query batch para posts + 1 query batch inversa para users
    // (WHERE id IN (DISTINCT user_id from posts)). Cierra N+1 sin
    // workaround manual con is_in([...]).
    let conn = open_db().await?
    return Post.preload("user").all(conn).await
}

@get("/posts/drafts")
async fn list_drafts() -> Result<List<Post>> {
    // Deuda #3 (v0.10.5) — .has_key sobre JSONB. Emite SQL:
    //   SELECT ... FROM posts WHERE "metadata" ? $1
    let conn = open_db().await?
    return Post.where(fn(p) => p.metadata.has_key("draft")).all(conn).await
}

@get("/posts/by-lang/{lang}")
async fn list_by_lang(lang: Str) -> Result<List<Post>> {
    // Deuda #3 (v0.10.5) — .get(key) con var externa + comparator.
    // Emite SQL: SELECT ... WHERE ("metadata"->>$1) = $2
    let conn = open_db().await?
    return Post.where(fn(p) => p.metadata.get("lang") == lang).all(conn).await
}

@post("/posts/search")
async fn search_posts(body: SearchInput) -> Result<List<Post>> {
    // Deuda #4 (v0.10.5) — chain dinámico condicional. El receiver
    // `qb` es var mutable; cada `.where()` adicional se agrega solo
    // si su branch ejecuta en runtime. SQL de cada fragmento queda
    // constante en compile-time. Desde v0.10.6 los closures de
    // .where(...) aceptan field access sobre vars externas
    // (`body.lang`, etc.) directamente, sin extraer a local.
    let conn = open_db().await?
    let qb = Post.where(fn(p) => p.id >= body.min_id)

    if (body.lang != "") {
        qb = qb.where(fn(p) => p.metadata.get("lang") == body.lang)
    }

    if (body.drafts_only) {
        qb = qb.where(fn(p) => p.metadata.has_key("draft"))
    }

    return qb.order_by(fn(p) => p.id).all(conn).await
}

@get("/user-count")
async fn user_count() -> Result<Int> {
    // Aggregate scalar: count total de users.
    let conn = open_db().await?
    return User.count(conn).await
}

@get("/stats/by-email")
async fn stats_by_email() -> Result<List<Map<Str, Any>>> {
    // GROUP BY email + count → un row por email distinto.
    // El codegen HTTP serializa Map<Str, Any> a JSON desde
    // v0.10.4 (deuda #1 cerrada — impl __MapKey for __FitzValue).
    let conn = open_db().await?
    return User.group_by(fn(u) => u.email).count(conn).await
}
