// 09b-indexing-slicing.fitz — Mini-tanda I (post-S, post-R).
// Índices negativos + slicing para listas y strings.

// --- I.1: índices negativos ---

let xs = [10, 20, 30, 40, 50]
print(xs[0])              // 10
print(xs[-1])             // 50 (último)
print(xs[-2])             // 40 (penúltimo)
print(xs[-5])             // 10 (= xs[0])

let s = "fitz"
print(s[0])               // f
print(s[-1])              // z

// Asignación con índice negativo (mutación in-place):
xs[-1] = 99
print(xs)                 // [10, 20, 30, 40, 99]

// --- I.2: slicing ---

// xs[start..end] (end exclusivo)
print(xs[1..3])           // [20, 30]
// xs[..end]: desde el principio
print(xs[..2])            // [10, 20]
// xs[start..]: hasta el final
print(xs[3..])            // [40, 99]
// xs[..]: copia entera
print(xs[..])             // [10, 20, 30, 40, 99]
// xs[start..=end]: end inclusivo
print(xs[1..=3])          // [20, 30, 40]

// Negativos en slice (mismo wrap que indexing):
print(xs[-2..])           // [40, 99]
print(xs[..-2])           // [10, 20, 30]
print(xs[-3..-1])         // [30, 40]

// Out-of-range: clamp silencioso (estilo Python):
print(xs[100..])          // []        (start fuera)
print(xs[..100])          // [10, 20, 30, 40, 99]  (end clampea a len)
print(xs[3..1])           // []        (start > end)

// Slicing de Str:
let frase = "hola fitz"
print(frase[0..4])        // hola
print(frase[5..])         // fitz
print(frase[-4..])        // fitz
print(frase[..])          // hola fitz

// Slice devuelve COPIA: mutar el slice NO afecta al original.
let copia = xs[..]
copia[0] = -1
print(xs[0])              // 10 (xs original intacto)

// Combinado con métodos de la mini-tanda S:
let palabras = "a,b,c,d,e".split(",")
print(palabras[1..4])     // [b, c, d]
