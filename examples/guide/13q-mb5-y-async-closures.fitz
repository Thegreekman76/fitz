// Mini-tanda Mb5 + Async-cl — métodos chicos analíticos + async
// closures inline.
//
//   - Mb5 (4 métodos sobre colecciones + 2 sobre Str):
//     * `List.group_by(fn(T) -> K)` → `Map<K, List<T>>` agrupa.
//     * `List.zip_with(ys, fn(T, U) -> V)` → `List<V>` zip + map.
//     * `List.max_by(fn(T) -> Int)` / `min_by(...)` → `Result<T>`
//       máximo/mínimo por ranking.
//     * `Str.lines()` → `List<Str>` separa por `\n`.
//     * `Str.is_empty()` → `Bool`.
//
//   - Async-cl: `async fn(...) => ...` como closure inline. Habilita
//     patrones funcionales async — asignación a var local y paso como
//     arg (en `fitz run`). `fitz build` requiere fns async top-level
//     por ahora (boxing de Future<T> sin Pin todavía no implementado).

// --- List.group_by: agrupar por key derivada -------------------

let nums: List<Int> = [1, 2, 3, 4, 5, 6, 7, 8]
let by_parity: Map<Str, List<Int>> = nums.group_by(fn(n: Int) => if (n % 2 == 0) { "par" } else { "impar" })
print(by_parity["par"])                          // [2, 4, 6, 8]
print(by_parity["impar"])                        // [1, 3, 5, 7]

// Útil para clasificar instancias por algún field derivado.
type User { name: Str = "", role: Str = "guest" }

let users: List<User> = [
    User { name: "Ada", role: "admin" },
    User { name: "Bob", role: "guest" },
    User { name: "Cam", role: "admin" },
    User { name: "Dru", role: "moderator" },
]
let by_role: Map<Str, List<User>> = users.group_by(fn(u: User) => u.role)
print(by_role["admin"].len())                    // 2
print(by_role["guest"].len())                    // 1
print(by_role["moderator"].len())                // 1

// --- List.zip_with: zip + transform en un paso -----------------

let prices: List<Int> = [10, 20, 30]
let cantidades: List<Int> = [2, 5, 3]
let totales: List<Int> = prices.zip_with(cantidades, fn(p: Int, q: Int) => p * q)
print(totales)                                   // [20, 100, 90]

// Trunca al más corto.
let xs: List<Int> = [1, 2, 3, 4, 5]
let ys: List<Int> = [10, 20]
let combos: List<Int> = xs.zip_with(ys, fn(a: Int, b: Int) => a + b)
print(combos)                                    // [11, 22] — solo 2 elementos

// --- List.max_by / min_by: max/min por ranking ----------------

type Item { name: Str = "", score: Int = 0 }
let items: List<Item> = [
    Item { name: "X", score: 75 },
    Item { name: "Y", score: 92 },
    Item { name: "Z", score: 60 },
]

match items.max_by(fn(it: Item) => it.score) {
    Ok(best) => print("mejor: {best.name} ({best.score})"),
    Err(_) => print("vacío")
}
// → mejor: Y (92)

match items.min_by(fn(it: Item) => it.score) {
    Ok(worst) => print("peor: {worst.name} ({worst.score})"),
    Err(_) => print("vacío")
}
// → peor: Z (60)

// Lista vacía → Err.
let empty: List<Item> = []
match empty.max_by(fn(it: Item) => it.score) {
    Ok(_) => print("imposible"),
    Err(e) => print("vacía: {e}")
}
// → vacía: lista vacía

// --- Str.lines y Str.is_empty ---------------------------------

let texto: Str = "Hola\nFitz\n\nFin"
let renglones: List<Str> = texto.lines()
print(renglones)                                 // ["Hola", "Fitz", "", "Fin"]
print(renglones.len())                           // 4

// is_empty atajo de len() == 0 con intención clara.
print("".is_empty())                             // true
print("hola".is_empty())                         // false

// Pipeline canónico — filtrar líneas no vacías:
let lineas_validas: List<Str> = renglones.filter(fn(l: Str) => not l.is_empty())
print(lineas_validas)                            // ["Hola", "Fitz", "Fin"]
