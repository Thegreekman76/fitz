// guide_utils.fitz — módulo auxiliar para el capítulo 16 de la guía.
//
// Cargado desde 16-modulos.fitz con `import guide_utils` y
// `from guide_utils import User`. Por qué no `16-utils.fitz`:
// el binding generado por `import` toma el último segmento del
// path, y "16-utils" no es un identificador válido (arranca con
// dígito, contiene `-`). Con un nombre limpio queda usable como
// `guide_utils.greet(...)`.

let PREFIX = "saludos, "
let DEFAULT_NAME = "anon"

fn greet(name: Str) -> Str => "{PREFIX}{name}"

// PreF8.3: el default `name: Str = DEFAULT_NAME` referencia una
// const del módulo. El importer no necesita re-importar
// `DEFAULT_NAME` — el loader pre-evalúa los defaults en el env
// del módulo, así `User {}` desde el importer aplica `"anon"`
// transparentemente.
type User {
    id: Int = 0
    name: Str = DEFAULT_NAME
}
