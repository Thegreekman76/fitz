// 05-strings.fitz — Strings, concatenación e interpolación.

name = "Fitz"
print(name)

// Concatenación con + (solo Str + Str).
greeting = "Hola, " + name
print(greeting)

// Interpolación con {}.
print("Hola, {name}!")

// Cualquier tipo primitivo se interpola.
count = 42
ratio = 3.14
active = true
nothing = null
print("count={count}, ratio={ratio}, active={active}, nothing={nothing}")

// Adentro de {...} pueden ir expresiones, no solo identificadores.
print("dos más dos es {2 + 2}")
print("doble: {count * 2}")

// Escapes.
print("línea 1\nlínea 2")
print("nombre:\tFitz")
print("dijo: \"hola\"")
print("barra: \\")

// Para una llave literal, escapala con \{ y \}.
print("config: \{ port: 3000 \}")

// Strings multilínea con """...""" (R.1.5, mini-fase R).
// Newlines literales se preservan; la interpolación sigue
// funcionando; comillas dobles aisladas adentro se preservan
// (solo `"""` cierra).
let sql = """
SELECT u.id, u.name
FROM users u
WHERE u.active = true
"""
print(sql)

// Las llaves externas del JSON las escapamos con \{ \} para no
// chocar con la interpolación de Fitz; las internas {name}/{count}
// sí se interpolan.
let json = """\{"name": "{name}", "count": {count}\}"""
print(json)
