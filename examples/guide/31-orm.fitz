// cap 31 — ORM nativo (Fase 10.b + deudas residuales v0.10.5).
//
// Postgres + Fitz: types con decoradores @table, @primary, @column,
// @belongs_to, @has_many. Una sola fuente de verdad para schema +
// queries tipadas + relations + aggregates + JSONB. Sin lib externa:
// el driver Postgres puro y el ORM están en el binario `fitz` mismo.
//
// Diferenciales vs SQLAlchemy / Active Record / Diesel:
//   - `fitz build` produce binario standalone con el ORM linkeado.
//   - paridad bit-a-bit `fitz run` ↔ `fitz build`.
//   - validación estática: el checker tipa `Future<Result<User>>`
//     vs `Future<Result<List<User>>>` según la chain — sin Any.
//
// Este ejemplo es PEDAGÓGICO — muestra el shape canónico. Para
// ejecutarlo necesitás un Postgres real con el schema de abajo
// (CREATE TABLE users + posts). Sin Postgres válido, el `connect`
// final imprime una Err clara y el smoke `GUIDE_EXAMPLES_COMPILE`
// solo verifica que compile a binario.

// --- 1. Definición de types con @table ------------------------------

@table("users") type User {
    @primary id: Int = 0
    name: Str
    age: Int

    // @has_many: el field virtual `posts` se hidrata vía navigation
    // (`u.posts(db)`) o eager loading (`User.preload("posts").all(db)`).
    // El SELECT/INSERT normal lo skipea (paralelo a backref de
    // SQLAlchemy declarative).
    @has_many("Post", via="user_id") posts: List<Post>
}

@table("posts") type Post {
    @primary id: Int = 0
    title: Str

    // @belongs_to: el field `user_id` es FK real (entra al SELECT
    // y al INSERT). El nav method `post.user_id(db)` resuelve al
    // User correspondiente.
    @belongs_to("User") user_id: Int

    // Deuda #2 (v0.10.5) — BelongsTo companion via convention.
    // Sibling field `user` (stripping `_id` del FK) auto-detectado
    // por el checker. Habilita `Post.preload("user").all(db)` para
    // cerrar el N+1 con 1 query batch inversa (target.id IN parent.fk).
    // Sin preload, el field queda en null.
    user: User?

    // Deuda #3 (v0.10.5) — JSONB field. Map<Str, Any> ↔ jsonb.
    // Habilita JSON operators en .where: .has_key/.has_all_keys/
    // .has_any_keys/.contains_json/.get mapeados a Postgres nativo
    // (`?`, `?&`, `?|`, `@>`, `->>`).
    metadata: Map<Str, Any>
}

// --- 2. Patrones canónicos del ORM ----------------------------------

async fn demo(db_url: Str) -> Result<Str> {
    let db = db.connect(db_url).await?

    // 2.1 — Insert: el server asigna el id (bigserial).
    // Maps heterogéneos (Str/Int/Bool mix) → codegen emite shape jsonb
    // (Vec<(__FitzValue, __FitzValue)>) que matchea Map<Str, Any>.
    let inserted = User.insert(db, User {
        id: 0, name: "ada", age: 35, posts: []
    }).await?
    let new_id = inserted.id

    // 2.2 — SELECT con WHERE chain + first.
    let one = User.where(fn(u) => u.id == new_id).first(db).await?

    // 2.3 — Chain con order_by + limit + offset (paginación).
    let top = User.where(fn(u) => u.age >= 18)
        .order_by(fn(u) => -u.age)
        .limit(10)
        .offset(0)
        .all(db).await?

    // 2.4 — Operadores extendidos en .where: like / is_in / between.
    let pattern = User.where(fn(u) => u.name.starts_with("a")).all(db).await?
    let bands = User.where(fn(u) => u.age.between(18, 65)).all(db).await?
    let ids = User.where(fn(u) => u.id.is_in([1, 2, 3])).all(db).await?

    // 2.5 — Aggregates scalares: sum / avg / min / max / count.
    let total_users = User.count(db).await?
    let avg_age = User.avg(fn(u) => u.age, db).await?

    // 2.6 — Aggregates con GROUP BY (Aggregated<Row>): devuelve
    // List<Map<Str, Any>> con un row por grupo.
    let by_age = User.group_by(fn(u) => u.age).count(db).await?

    // 2.7 — Navigation: belongs_to y has_many.
    let post1 = Post.where(fn(p) => p.id == 1).first(db).await?
    let author = post1.user_id(db).await?           // BelongsTo → User.
    let ada_posts = inserted.posts(db).await?       // HasMany → List<Post>.

    // 2.8 — Eager loading: 1 query batch en vez de N+1.
    let with_posts = User.preload("posts").all(db).await?

    // Deuda #2 (v0.10.5) — BelongsTo eager via companion field.
    // `.preload("user")` (companion auto-detectado) carga todos los
    // users referenciados en 1 query batch inversa. Post.user queda
    // poblado en cada row sin más round-trips.
    let posts_with_authors = Post.preload("user").all(db).await?

    // Deuda #3 (v0.10.5) — JSON operators en .where(...).
    // Mapean a operadores Postgres nativos:
    //   .has_key("k")            → "metadata" ? $N
    //   .has_all_keys([...])     → "metadata" ?& $N::text[]
    //   .has_any_keys([...])     → "metadata" ?| $N::text[]
    //   .contains_json({...})    → "metadata" @> $N::jsonb
    //   .get("k")                → ("metadata"->>$N) text result
    let drafts = Post.where(fn(p) => p.metadata.has_key("draft")).all(db).await?
    let promo = Post.where(fn(p) => p.metadata.contains_json({"campaign": "summer"})).all(db).await?
    let by_lang = Post.where(fn(p) => p.metadata.get("lang") == "es").all(db).await?

    // Deuda #4 (v0.10.5) — chain dinámico condicional. El receiver
    // de cada chain method puede ser var mutable. El SQL final es
    // constante por branch (cada fragmento se construye en
    // compile-time), pero el SHAPE del chain se decide en runtime.
    let qb = User.where(fn(u) => u.age >= 0)
    let want_adults = true
    if (want_adults) {
        qb = qb.where(fn(u) => u.age >= 18)
    }
    let dynamic = qb.order_by(fn(u) => u.id).all(db).await?

    // 2.9 — Update + delete con guard `.where(...)` obligatorio.
    let updated_rows = User.where(fn(u) => u.id == new_id).update(db, {"age": 36}).await?
    let deleted_rows = User.where(fn(u) => u.id == new_id).delete(db).await?

    // 2.10 — v0.10.6 — fricciones residuales cerradas (W1-W7).
    //
    // W3: .starts_with / .ends_with / .contains aceptan vars Str.
    // El SQL se envuelve con `||` Postgres (`$N || '%'`, etc.).
    let prefix = "a"
    let by_prefix = User.where(fn(u) => u.name.starts_with(prefix)).all(db).await?
    // W6: field access sobre vars externas en closures de .where.
    let want = User { id: 0, name: "ada", age: 35, posts: [] }
    let same_age = User.where(fn(u) => u.age == want.age).all(db).await?
    // W7: .update(db, changes) acepta Map var (no solo literal).
    let changes: Map<Str, Any> = {"age": 37}
    let upd_again = User.where(fn(u) => u.id == new_id).update(db, changes).await?

    return Ok("ORM demo: {len(top)} top users, {total_users} total, {len(by_age)} grupos por edad, {len(dynamic)} dynamic, {len(by_prefix)} by_prefix, {len(same_age)} same_age")
}

// --- 3. Entry point -------------------------------------------------

async fn driver() -> Str {
    // `fitz build` con URL inválida → connect falla con Err clara.
    // Para correr el demo real, sustituir por la URL de tu Postgres
    // con el schema:
    //   CREATE TABLE users (id bigserial PK, name text, age bigint);
    //   CREATE TABLE posts (
    //     id bigserial PK, title text,
    //     user_id bigint REFERENCES users(id),
    //     metadata jsonb
    //   );
    return match demo("postgres://demo:demo@localhost/fitz_demo").await {
        Ok(s) => s
        Err(e) => "ejemplo ORM listo (sin Postgres real: {e})"
    }
}

print(driver().await)
