// 06-logica.fitz — Operadores lógicos.

// and / or operan sobre Bool y devuelven Bool.
print(true and true)
print(true and false)
print(false or true)
print(false or false)

// Combinando con comparación: los usos típicos.
let age = 20
print(age >= 18 and age < 65)   // ¿en edad de trabajar?
print(age < 13 or age >= 65)    // ¿aplica descuento?

// Short-circuit:
//   - `or`: si el izquierdo ya es true, no evalúa el derecho.
//   - `and`: si el izquierdo ya es false, no evalúa el derecho.
fn ruido() -> Bool {
    print("¡me llamaron!")
    return true
}

print(true or ruido())     // imprime solo "true"
print(false and ruido())   // imprime solo "false"
print(true and ruido())    // imprime "¡me llamaron!" y luego "true"

// Precedencia: `and` ata más fuerte que `or`.
print(true or false and false)     // true: (false and false) se resuelve primero
print((true or false) and false)   // false: los paréntesis cambian el orden

// Negación con `not` (R.1.1, mini-fase R). Exige Bool estricto;
// `not 0` o `not ""` son type error (sin truthy/falsy).
let active = false
print(not active)                  // true
print(not not active)              // false (doble negación)

if (not active) {
    print("inactivo — flag al revés")
}

// not se aplica antes que las comparaciones, así que para negar
// el RESULTADO de una comparación hace falta paréntesis:
let n = 5
print(not (n == 10))               // true: niega el bool resultante

// `xor` (mini-tanda Xor): "exactamente uno de los dos". Equivale a
// `a != b` sobre Bool pero se lee más declarativo. NO short-circuita.
print(true xor true)               // false
print(true xor false)              // true
print(false xor true)              // true
print(false xor false)             // false

// Caso típico: validar que se pasó EXACTAMENTE una de dos opciones.
fn solo_uno(p: Bool, q: Bool) -> Bool {
    return p xor q
}

print(solo_uno(true, false))       // true — solo uno activo
print(solo_uno(true, true))        // false — ambos activos

// Chain: `xor` y `or` tienen la misma precedencia, left-associative.
// `a or b xor c` parsea como `(a or b) xor c`.
print(true or false xor true)      // false — (true or false)=true, xor true=false
print(true xor false xor true)     // false — ((T xor F)=T xor T)=F
