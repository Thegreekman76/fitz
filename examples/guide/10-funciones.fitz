// 09-funciones.fitz — Funciones, recursión y closures.

// Forma de bloque.
fn greet(name) {
    return "Hola, {name}!"
}
print(greet("Fitz"))

// Forma flecha (una expresión).
fn double(n) => n * 2
print(double(21))

// Con anotaciones (se aceptan, todavía no se validan).
fn add(a: Int, b: Int) -> Int {
    return a + b
}
print(add(2, 3))

// Sin return explícito → la función devuelve null.
fn nothing() {
    let x = 1
}
print(nothing())

// Recursión.
fn fact(n) {
    if n <= 1 {
        return 1
    }
    return n * fact(n - 1)
}
print(fact(5))

// Closure: la función interna captura `x` del scope externo.
fn make_adder(x) {
    fn add(y) => x + y
    return add
}
add5 = make_adder(5)
print(add5(3))

// Pasar funciones como argumento.
fn apply(f, x) => f(x)
fn square(n) => n * n
print(apply(square, 7))
