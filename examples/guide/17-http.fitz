// 17-http.fitz — Ejemplo del capítulo 17 "HTTP nativo".
//
// Mini API REST en memoria con dos tipos, lista de usuarios, y
// endpoints para listar, traer por id y crear. Sin base de datos:
// la "memoria" del server es el env del programa.
//
// Levantalo:
//   cargo run -- run examples/guide/17-http.fitz
//
// Probalo:
//   curl http://127.0.0.1:3000/
//   curl http://127.0.0.1:3000/users
//   curl http://127.0.0.1:3000/users/1
//   curl http://127.0.0.1:3000/users/99
//   curl -X POST http://127.0.0.1:3000/users \
//        -H "Content-Type: application/json" \
//        -d '{"name":"sofi"}'
//   curl -i http://127.0.0.1:3000/protected           # status 401
//   curl -i http://127.0.0.1:3000/users/1/profile     # status 200 con user
//   curl -i http://127.0.0.1:3000/users/99/profile    # status 404 custom

@server(3000)
fn main() => 0

type User {
    id: Int
    name: Str
    email: Str?
}

type UserInput {
    name: Str
    email: Str?
}

let users = [
    User { id: 1, name: "ana", email: "ana@x.com" },
    User { id: 2, name: "luis", email: null },
]

// Las anotaciones de return son necesarias para `fitz build` (deuda
// 5b.1 — inferencia en codegen). `fitz run` infiere igual.

@get("/")
fn index() -> Str => "Fitz HTTP corriendo"

@get("/users")
fn list_users() -> List<User> => users

@get("/users/{id}")
fn get_user(id: Int) -> Result<User> {
    let found = users.find(fn(u) => u.id == id)
    return match found {
        Ok(u)  => Ok(u)
        Err(_) => Err("usuario {id} no encontrado")
    }
}

@post("/users")
fn create_user(body: UserInput) -> User {
    let new_id = users.len() + 1
    let u = User { id: new_id, name: body.name, email: body.email }
    users.push(u)
    return u
}

// --- Status codes custom ---
//
// Sintaxis nueva del spec: `return <status> <body>` adentro de un
// handler HTTP. El status es un Int literal (100-599), el body
// cualquier expr serializable a JSON. El runtime emite el status
// pedido + body, en vez del 200/500 default.

@get("/protected")
fn protected() -> Str {
    return 401 {"message": "no autorizado"}
}

// Polimórfico: la misma fn puede `return u` (200) o `return 404 ...`.
// El return type formal (`User`) no se chequea contra el body del
// status custom — solo se chequea contra los returns normales.
//
// (En match arms el body es una Expr, no un Stmt; por eso desarmamos
// el match con if/else sobre `.len()` del filter — patrón canónico
// cuando hace falta `return` adentro de cada rama.)

@get("/users/{id}/profile")
fn user_profile(id: Int) -> User {
    let matches = users.filter(fn(u) => u.id == id)
    if (matches.len() == 0) {
        return 404 {"error": "usuario {id} no existe"}
    }
    return matches[0]
}
