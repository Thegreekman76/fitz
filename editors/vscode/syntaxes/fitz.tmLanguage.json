{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fitz",
  "scopeName": "source.fitz",
  "fileTypes": ["fitz"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings-triple" },
    { "include": "#bytes-literal" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#decorators" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#labels" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fitz",
          "match": "//.*$"
        },
        {
          "name": "comment.block.fitz",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings-triple": {
      "name": "string.quoted.triple.fitz",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "name": "constant.character.escape.unicode.fitz",
          "match": "\\\\u\\{[0-9A-Fa-f]{1,6}\\}"
        },
        {
          "name": "constant.character.escape.hex.fitz",
          "match": "\\\\x[0-9A-Fa-f]{2}"
        },
        {
          "name": "constant.character.escape.fitz",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded.expression.fitz",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.fitz" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.fitz" }
          },
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "bytes-literal": {
      "name": "string.quoted.double.bytes.fitz",
      "begin": "\\bb\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.hex.fitz",
          "match": "\\\\x[0-9A-Fa-f]{2}"
        },
        {
          "name": "constant.character.escape.fitz",
          "match": "\\\\[nrt0\\\\\"]"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.fitz",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.unicode.fitz",
          "match": "\\\\u\\{[0-9A-Fa-f]{1,6}\\}"
        },
        {
          "name": "constant.character.escape.hex.fitz",
          "match": "\\\\x[0-9A-Fa-f]{2}"
        },
        {
          "name": "constant.character.escape.fitz",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded.expression.fitz",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.fitz" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.fitz" }
          },
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "numbers": {
      "comment": "Mini-phase Num — `_` separators and `e/E` scientific notation. Mini-phase Lit — hex/binary/octal literals with `0x`/`0b`/`0o` prefixes. Mini-phase Cmp — uppercase `0X`/`0B`/`0O` prefixes also supported. Most specific patterns first (hex/bin/oct before float/int decimal).",
      "patterns": [
        {
          "name": "constant.numeric.hex.fitz",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.fitz",
          "match": "\\b0[bB][01][01_]*\\b"
        },
        {
          "name": "constant.numeric.octal.fitz",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.fitz",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?\\b"
        },
        {
          "name": "constant.numeric.float.fitz",
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.fitz",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "decorators": {
      "name": "entity.name.function.decorator.fitz",
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fitz",
          "match": "\\b(if|else|while|for|loop|match|return|break|continue|in|async|await)\\b"
        },
        {
          "name": "keyword.declaration.fitz",
          "match": "\\b(let|fn|type|import|from|as|static)\\b"
        },
        {
          "name": "keyword.operator.logical.fitz",
          "match": "\\b(not|and|or|xor)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.fitz",
          "match": "\\b(Int|Float|Str|Bool|Null|Bytes|Range|Any|List|Map|Result|Future|Request|Response|File|PyAny|WsConn|DbConn|DbRow|Date|DateTime|Uuid)\\b"
        },
        {
          "name": "entity.name.type.fitz",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.fitz",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.fitz",
          "match": "\\bnull\\b"
        },
        {
          "name": "variant.fitz",
          "match": "\\b(Ok|Err)\\b"
        }
      ]
    },
    "builtins": {
      "name": "support.function.builtin.fitz",
      "match": "\\b(print|len|sleep|cors|bytes|spawn|assert|assert_eq|assert_ne|assert_throws|popcount|leading_zeros|trailing_zeros|rotate_left|rotate_right|abs|min|max|pow|sqrt|ceil|floor|round|clamp|env|env_or|load_env|ws_broadcast)\\b(?=\\s*\\()"
    },
    "labels": {
      "comment": "Loop labels (mini-phase L): `'outer:` at declaration site and `'outer` at break/continue. The trailing `:` is optional and NOT consumed here — the rest of the parser picks it up.",
      "name": "entity.name.label.fitz",
      "match": "'[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.fitz",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.range.fitz",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.try.fitz",
          "match": "\\?"
        },
        {
          "comment": "Mini-phase Bits — shifts `<<`/`>>`. BEFORE comparison so `<=`/`>=` are not confused with sub-sequences like `<` + `<`.",
          "name": "keyword.operator.bitwise.shift.fitz",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.fitz",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.fitz",
          "match": "&&|\\|\\||!"
        },
        {
          "comment": "Or-pattern in match arms (R.2.1): `Ok | Err =>`. Also used as bitwise OR (mini-phase Bits). Goes after the logical operator (`||`) so two consecutive pipes match as `||`.",
          "name": "keyword.operator.alternative.fitz",
          "match": "\\|"
        },
        {
          "comment": "Mini-phase Bits — bitwise AND `&`, XOR `^`, unary NOT `~`. `&` does not clash with `&&` because the logical operator was already matched above.",
          "name": "keyword.operator.bitwise.fitz",
          "match": "&|\\^|~"
        },
        {
          "comment": "Compound assignment (R.2.3 + mini-phase Cmp). Arithmetic: `+= -= *= /= %=`. Bitwise: `&= |= ^= <<= >>=`. Goes before lone `=`/`<<`/`>>`/`&`/`|`/`^` so the regex does not stop at the first letter. The compound shifts `<<=`/`>>=` go before `<<`/`>>` for the same reason.",
          "name": "keyword.operator.assignment.compound.fitz",
          "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^="
        },
        {
          "name": "keyword.operator.assignment.fitz",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.fitz",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "comment": "Function definition: `fn name(...)`",
          "match": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.fitz" }
          }
        },
        {
          "comment": "Function call: `name(...)` (non-builtin)",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.fitz" }
          }
        }
      ]
    }
  }
}
