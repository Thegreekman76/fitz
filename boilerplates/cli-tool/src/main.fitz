// cli-tool boilerplate — generador de report de ventas (v0.11.0).
//
// **Hito de Fase 13**: este boilerplate ahora usa `@command` para
// declarar comandos CLI nativos del lenguaje. El binario producido
// por `fitz build` parsea `std::env::args()` automáticamente y
// dispatcha al comando correspondiente. Help auto-generado,
// validación de tipos, exit codes tipados.
//
// Demuestra:
//   - `@command("name", desc="...")` para declarar comandos.
//   - Multi-comando con dispatch automático (3 commands).
//   - Positional args (params sin default) + flags (params con default).
//   - Overrides `@arg`/`@flag` (v0.37.13): help por param + short
//     flag elegido a mano (ej: `count` usa `-r` para `--region`).
//   - Help autogenerado: `cli-tool --help`, `cli-tool report --help`.
//   - Exit codes tipados (`Int` return).
//   - State compartido entre handlers (`let SALES` top-level).
//
// El binario `fitz build` produce ~5 MB standalone (Linux con musl
// + `FROM scratch` en Docker, ~22 MB imagen completa).

type Sale {
    product: Str,
    amount: Float,
    region: Str,
}

// Data hardcoded como fn helper — en un tool real reemplazá con
// lectura desde stdin, archivo o DB. Usamos fn en vez de `let X = [...]`
// top-level porque el codegen no hoistea list literals con struct lits
// como statics (deuda menor de la Fase 13 — list de structs sí
// funcionan como locals adentro de fns).
fn all_sales() -> List<Sale> {
    return [
        Sale { product: "widget", amount: 99.50, region: "AR" },
        Sale { product: "widget", amount: 149.00, region: "BR" },
        Sale { product: "gadget", amount: 250.00, region: "AR" },
        Sale { product: "gadget", amount: 320.00, region: "US" },
        Sale { product: "thingamajig", amount: 12.50, region: "AR" },
        Sale { product: "thingamajig", amount: 18.75, region: "BR" },
        Sale { product: "widget", amount: 110.00, region: "US" },
    ]
}

// --- Helpers (sin @command — solo fns regulares) ---

fn total(sales: List<Sale>) -> Float {
    return sales.reduce(0.0, fn(acc: Float, s: Sale) => acc + s.amount)
}

fn by_region(sales: List<Sale>, region: Str) -> List<Sale> {
    return sales.filter(fn(s: Sale) => s.region == region)
}

fn distinct_regions(sales: List<Sale>) -> List<Str> {
    let names = sales.map(fn(s: Sale) => s.region)
    return names.unique()
}

fn pick_top(acc: Sale, s: Sale) -> Sale {
    if (s.amount > acc.amount) { return s }
    return acc
}

// --- Comandos CLI ---

/// `cli-tool report [--min <FLOAT>]`
/// Imprime el report completo (totales + by-region + top venta).
/// Opcional: filtra ventas con monto mínimo.
@command("report", desc="Show full sales report (summary + per-region + top)")
fn report(@flag(help="minimum amount to include") min: Float = 0.0) -> Int {
    let sales = all_sales()
    let filtered = sales.filter(fn(s: Sale) => s.amount >= min)
    print("📊 Sales Report")
    print("===============")
    print("")
    print("Total ventas: {filtered.len()}")
    print("Revenue total: ${total(filtered):.2f}")
    print("")
    print("Por región:")
    for region in distinct_regions(filtered) {
        let subset: List<Sale> = by_region(filtered, region)
        print("  {region}: {subset.len()} ventas, ${total(subset):.2f}")
    }
    print("")
    print("Top venta única:")
    if (filtered.len() == 0) {
        print("  (lista vacía — exit code 1)")
        return 1
    }
    let top: Sale = filtered.reduce(filtered[0], pick_top)
    print("  {top.product} (${top.amount:.2f}) en {top.region}")
    return 0
}

/// `cli-tool count [--region <STR>]`
/// Cuenta cuántas ventas hay, opcionalmente filtrando por región.
@command("count", desc="Quick count of sales (with optional region filter)")
fn count(@flag(short="r", help="filter by this region") region: Str = "all") -> Int {
    let sales = all_sales()
    if region == "all" {
        print("{sales.len()}")
    } else {
        print("{by_region(sales, region).len()}")
    }
    return 0
}

/// `cli-tool regions`
/// Lista las regiones únicas presentes en los datos, una por línea.
@command("regions", desc="List unique regions present in the data")
fn regions() -> Int {
    for r in distinct_regions(all_sales()) {
        print(r)
    }
    return 0
}
