# Dockerfile.distroless — variante ultra-minimalista de api-orm-full.
# Imagen final ~15-20 MB (vs ~80 MB del Dockerfile regular con
# debian:bookworm-slim).
#
# Usa `gcr.io/distroless/cc-debian12` como runtime (binarios C
# dinámicos compilados contra glibc, sin shell, sin coreutils, sin
# package manager). El binario fitz-app es self-contained.
#
# **v0.10.11 (2026-05-29)**: migrado de `cargo install --git` al
# patrón pre-built `ghcr.io/thegreekman76/fitz:latest` (~10x más
# rápido). La imagen `:latest` se actualiza en cada release del repo.
#
# Build (LATEST):
#   docker build -f Dockerfile.distroless -t api-orm-full:distroless .
#
# Build con tag pinned:
#   docker build -f Dockerfile.distroless --build-arg FITZ_TAG=v0.10.10 -t api-orm-full:distroless .

# ---- Stage 1: builder ----------------------------------------------
ARG FITZ_TAG=latest
FROM ghcr.io/thegreekman76/fitz:${FITZ_TAG} AS builder

WORKDIR /app
COPY fitz.toml ./
COPY src/ ./src/

RUN fitz build src/main.fitz

# ---- Stage 2: runtime distroless -----------------------------------
FROM gcr.io/distroless/cc-debian12

COPY --from=builder /app/src/main /app

EXPOSE 3000

ENTRYPOINT ["/app"]
