// config.fitz — configuración del boilerplate api-orm-full.
//
// Centraliza la lectura de env vars en helpers reusables desde el
// resto de los módulos. No expone `let X = env_or(...)` top-level
// porque la deuda 5b.5 del codegen restringe RHS no literales a
// nivel de módulo — los helpers leen on-demand.
//
// **Defaults útiles para `fitz run` local** (sin Docker). En
// docker-compose.yml las env vars apuntan al servicio `db:5432`.

// db_url — connection string al Postgres. Default apunta a
// localhost para correr `fitz run src/main.fitz` sin Docker
// (con un Postgres corriendo en localhost:5432 con user `fitz`).
fn db_url() -> Str => env_or("DATABASE_URL", "postgres://fitz:fitz@localhost:5432/fitz?sslmode=disable")

// jwt_secret — secret del HMAC del JWT. **Cambiar en producción**
// vía la env var `JWT_SECRET`. El default es para que el ejemplo
// arranque sin setup extra; no usar tal cual en producción real.
fn jwt_secret() -> Str => env_or("JWT_SECRET", "demo-orm-full-secret-cambiame-en-prod")

// max_drafts_age_days — drafts viejos que el cron borra al correr.
// Default 30 días. Configurable vía env var `MAX_DRAFTS_AGE_DAYS`.
fn max_drafts_age_days() -> Str => env_or("MAX_DRAFTS_AGE_DAYS", "30")

// webhook_url — URL externa a notificar cuando un post pasa a
// "published" (PUT /posts/{id} con status="published"). Caso típico
// CMS: notificar a Slack/Discord/Sentry/cualquier endpoint que
// escuche eventos del blog.
//
// **Opt-in via env var**: si `WEBHOOK_URL` no está seteada o es
// "", el dispatch se skipea silenciosamente. Sin overhead para el
// caso 90% (dev local). En producción, setear a la URL real.
//
// Showcase del módulo `http` builtin del lenguaje (cap M5.C5 del
// curso, cap 17 sub-sec "HTTP client outbound" de la guía).
fn webhook_url() -> Str => env_or("WEBHOOK_URL", "")

// smtp_enabled — flag opt-in del email outbound. Si la env var
// `SMTP_ENABLED` viene como "true"/"1"/"yes", el handler de
// "published" dispara también un email al autor. Por defecto OFF
// (dev local arranca sin MailHog/SMTP setup).
//
// El módulo `smtp` built-in (mini-tanda v0.18.0, cap 17 sub-sec
// "SMTP outbound" de la guía) lee SMTP_HOST/PORT/USER/PASSWORD/
// FROM/TLS al primer send. Para dev local levantás MailHog en
// localhost:1025 (`docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog`)
// y exportás SMTP_HOST=localhost / SMTP_PORT=1025 / SMTP_TLS=none.
fn smtp_enabled() -> Bool {
    let v = env_or("SMTP_ENABLED", "")
    return v == "true" or v == "1" or v == "yes"
}
