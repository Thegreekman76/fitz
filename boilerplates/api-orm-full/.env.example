# Variables de entorno para api-orm-full.
#
# Copiar a .env y ajustar según necesidad. El docker-compose.yml lee
# este archivo automáticamente vía la sintaxis ${VAR:-default}.

# Credenciales Postgres (default: fitz/fitz).
POSTGRES_USER=fitz
POSTGRES_PASSWORD=fitz
POSTGRES_DB=fitz

# JWT secret — CAMBIAR en producción. Cualquier valor random largo
# sirve. Recomendado: `openssl rand -base64 64`.
JWT_SECRET=demo-orm-full-secret-cambiame-en-prod-xxxxxxxxxx

# Edad máxima en días de drafts antes que el @cron los borre.
# Por default 30 días — todos los días a medianoche UTC.
MAX_DRAFTS_AGE_DAYS=30

# Webhook outbound al publicar un post (showcase del módulo `http`
# builtin del lenguaje). Cuando un PUT /posts/{id} cambia status a
# "published" y WEBHOOK_URL está seteada, el handler dispatcha un
# webhook fire-and-forget a esta URL con `@background + spawn(...)`.
#
# Vacío (default) → no dispatcha. En producción: la URL real
# (Slack incoming webhook, Discord, tu API de analytics, etc.).
# Para probar end-to-end: https://httpbin.org/post echoea el body.
WEBHOOK_URL=
