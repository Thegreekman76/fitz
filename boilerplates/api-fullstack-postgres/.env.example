# Variables de entorno del boilerplate api-fullstack-postgres.
#
# Setup:
#   cp .env.example .env
#   # editar .env con tus credenciales preferidas
#
# El `.env` está en .gitignore y .dockerignore — no se sube al repo.

# Postgres credentials. `docker-compose.yml` inyecta estos al
# container `db` (Postgres 16 alpine) Y al container `api` (Fitz +
# Python) via DATABASE_URL construido a partir de estos.
POSTGRES_USER=fitz
POSTGRES_PASSWORD=fitz
POSTGRES_DB=fitz

# Para producción: usar credenciales fuertes generadas
# aleatoriamente. Nunca commitear el `.env` real.
