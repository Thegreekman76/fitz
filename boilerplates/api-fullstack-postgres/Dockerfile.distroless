# Dockerfile.distroless — variante con `fitz build --bundle-pip-requirements`
# + runtime distroless. Habilitado por v0.9.46 (launcher del binario
# standalone usa crates `tar` + `flate2` inline en lugar de invocar
# `Command::new("tar")` subprocess — destraba runtimes minimalistas que
# NO traen utilidades de shell).
#
# Ver `boilerplates/api-postgres-python/Dockerfile.distroless` para
# notas técnicas completas. Esta variante aplica el mismo patrón al
# fullstack — SOLO el container del api. El frontend SPA sigue siendo
# servido por nginx en su propio container (3 servicios: api +
# nginx + db), igual que el `Dockerfile` actual. Esto permite que
# `@middleware(cors(...))` del api responda al preflight OPTIONS del
# browser cuando se cargan los assets desde otro origin.
#
# Imagen final (api solo): **~136 MB real validado** (v0.9.52) — el
# binario standalone con CPython 3.14.5 + sqlalchemy + psycopg2-binary
# embebidos pesa más de lo estimado en abstracto (~80-100 MB del
# plan original). Sigue siendo ~15% más chica que los ~155 MB del
# Dockerfile actual con `python:3.12-slim` + `fitz run`.
#
# Smoke real Docker boilerplate 6 validado v0.9.52: build OK,
# api bootea + conecta a Postgres + responde HTTP, frontend SPA
# cargado por nginx separado consume el api via CORS.
#
# Build con tag específico:
#   docker build -f Dockerfile.distroless --build-arg FITZ_TAG=v0.9.48 -t app:distroless .

# ---- Stage 1: builder ----------------------------------------------
FROM python:3.14-slim-bookworm AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl ca-certificates git \
        python3-dev pkg-config libssl-dev libpq-dev build-essential && \
    rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain 1.95.0 --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

ARG FITZ_TAG=v0.9.48

RUN cargo install --git https://github.com/Thegreekman76/fitz \
    --tag "$FITZ_TAG" --features python --bin fitz --locked

WORKDIR /app

# Capas cacheables primero (cambian menos seguido).
COPY fitz.toml requirements.txt ./
COPY python/ ./python/

# Código Fitz al final.
COPY src/ ./src/

RUN fitz build --bundle-pip-requirements requirements.txt

# ---- Stage 2: runtime distroless -----------------------------------
FROM gcr.io/distroless/cc-debian12

COPY --from=builder /app/target/release/fitz-api-fullstack-postgres /usr/local/bin/app
COPY --from=builder /app/python /app/python

WORKDIR /app
ENV PYTHONPATH=/app/python

EXPOSE 3000

CMD ["app"]
