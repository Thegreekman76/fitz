// data/users.fitz — wrapper Fitz "raw" sobre los helpers Python
// en `python/db.py`.
//
// **Por qué este módulo devuelve `Result<Str>` (JSON crudo) en
// lugar de `Result<User>` tipado**:
//
// El loader de módulos Fitz hoy resuelve `from sub.foo import` de
// forma relativa al ARCHIVO importer, no al root del proyecto.
// Eso significa que si este archivo (`src/data/users.fitz`)
// importara `from types.user import User`, el loader buscaría en
// `src/data/types/user.fitz` (mal) en lugar de `src/types/user.fitz`
// (bien). Limitación documentada en `docs/deudas_lenguaje.md` →
// R.bug-loader-relative-only.
//
// **Workaround**: este módulo NO importa `User` ni `NewUser` — solo
// Python + json. Devuelve JSON strings que el main coerce a `User`
// con anotación destino (`let u: User = json.loads(s)?`, patrón
// canónico 8.4.3). La responsabilidad de "saber qué shape devuelve
// la DB" queda en el main, que es el único archivo que ya tiene
// `User` en scope. Trade-off aceptable mientras la deuda del
// loader no cierre.

from python import json
from python import db

// Crear un user nuevo. Postgres asigna `id` y `created_at`.
// Devuelve el JSON crudo del dict Python serializado.
fn create_raw(name: Str, email: Str) -> Result<Str> {
    let raw = db.add_user(name, email)?
    return Ok(json.dumps(raw)?)
}

// Buscar por id. Si no existe, propaga el NoResultFound de
// SQLAlchemy como `Err`.
fn find_raw(id: Int) -> Result<Str> {
    let raw = db.get_user(id)?
    return Ok(json.dumps(raw)?)
}

// Listar todos. Orden por id ASC del lado SQLAlchemy.
fn list_raw() -> Result<Str> {
    let raw = db.list_users()?
    return Ok(json.dumps(raw)?)
}

// Init de schema (idempotente). Llamado por main al boot.
fn init_schema() -> Result<Null> {
    let _ = db.init_db()?
    return Ok(null)
}
