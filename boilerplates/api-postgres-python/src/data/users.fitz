// data/users.fitz — wrapper Fitz sobre los helpers Python en
// `python/db.py`. Encapsula la coerción `dict → User` adentro del
// data layer, así el `main.fitz` solo recibe tipos Fitz limpios.
//
// El import `from types.user import User` resuelve via el
// import_root del loader (parent del entry file `src/main.fitz`)
// porque la búsqueda relativa desde `src/data/` no encuentra el
// archivo. Habilitado por la mini-fase loader-absoluto del
// lenguaje (2026-05-22).

from python import json
from python import db
from types.user import User
from types.api import NewUser

// Crear un user nuevo. Postgres asigna `id` y `created_at`.
fn create(name: Str, email: Str) -> Result<User> {
    let raw = db.add_user(name, email)?
    let u: User = json.loads(json.dumps(raw)?)?
    return Ok(u)
}

// Buscar por id. Si no existe, propaga el NoResultFound de
// SQLAlchemy como `Err`.
fn find(id: Int) -> Result<User> {
    let raw = db.get_user(id)?
    let u: User = json.loads(json.dumps(raw)?)?
    return Ok(u)
}

// Listar todos. Devuelve `List<User>` tipado — la coerción
// recursiva runtime (R.missing-recursive-instance-coercion,
// CERRADO 2026-05-22) hace que `let users: List<User> = ...`
// coerce cada dict a Instance automáticamente.
fn list_all() -> Result<List<User>> {
    let raw = db.list_users()?
    let users: List<User> = json.loads(json.dumps(raw)?)?
    return Ok(users)
}

// Init de schema (idempotente). Llamado por main al boot.
fn init_schema() -> Result<Null> {
    let _ = db.init_db()?
    return Ok(null)
}
