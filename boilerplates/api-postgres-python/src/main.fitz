// main.fitz — entry point del boilerplate api-postgres-python.
//
// Estructura del proyecto (módulos Fitz):
//   src/
//   ├── main.fitz                ← (este archivo) handlers HTTP
//   ├── types/
//   │   ├── user.fitz            ← `type User` (mirror SQLAlchemy)
//   │   └── api.fitz             ← `type NewUser` (body POST)
//   └── data/
//       └── users.fitz           ← wrapper "raw" Python (Str JSON)
//
// El loader de módulos de Fitz resuelve `from types.user import ...`
// relativo a ESTE archivo (`src/main.fitz`) → busca en
// `src/types/user.fitz`. Eso funciona porque main vive en `src/`.
//
// **Por qué la coerción `dict → User` ocurre acá y no en data/**:
// el loader Fitz hoy resuelve imports relativos al archivo
// importer. Si `data/users.fitz` importara `from types.user import
// User`, buscaría en `src/data/types/user.fitz` (mal). Workaround
// documentado: `data/users.fitz` devuelve JSON strings opacos;
// este archivo (main) tiene `User` en scope y hace la coerción
// final con `let u: User = json.loads(s)?` (8.4.3). Limitación
// del loader documentada en docs/deudas_lenguaje.md →
// R.bug-loader-relative-only.

from python import json
from types.user import User
from types.api import NewUser
from data.users import create_raw, find_raw, list_raw, init_schema

@server(3000, "0.0.0.0")
fn main() => 0

// Init de la DB en boot — crea tablas si no existen. Si falla
// (Postgres no levantó aún, credenciales mal, etc.), printeamos
// el error y seguimos arrancando — el primer request al API va
// a fallar con detalle del error de SQLAlchemy. Eso es preferible
// a un boot que cuelga indefinidamente esperando la DB.
match init_schema() {
    Ok(_)  => print("[boot] DB conectada y schema inicializado"),
    Err(e) => print("[boot] ERROR conectando a la DB — {e}"),
}

// POST /users — crear un user nuevo. El body se deserializa
// automático a `NewUser` (Fitz valida el shape). El `?` propaga
// errores SQLAlchemy (commit, conexión, etc.) → 500 con
// `{"error": "..."}`.
@post("/users")
fn create_user(body: NewUser) -> Result<User> {
    let raw = create_raw(body.name, body.email)?
    let u: User = json.loads(raw)?
    return Ok(u)
}

// GET /users/{id} — buscar por id. Si no existe, propaga el
// NoResultFound de SQLAlchemy como `Err`.
@get("/users/{id}")
fn get_user(id: Int) -> Result<User> {
    let raw = find_raw(id)?
    let u: User = json.loads(raw)?
    return Ok(u)
}

// GET /users — listar todos. Devuelve JSON crudo (List<User>
// Fitz nativa requeriría iterar el list opaco Python con
// anotación recursiva — deuda residual de coerción 8.4.3 sobre
// listas).
@get("/users")
fn list_users() -> Result<Str> {
    return list_raw()
}

print("[ready] Server arrancando en :3000")
print("[ready] Endpoints:")
print("[ready]   POST /users       — crear (body JSON: name, email)")
print("[ready]   GET  /users       — listar (JSON crudo)")
print("[ready]   GET  /users/<id>  — buscar por id (User tipado)")
print("[ready]   GET  /docs        — UI Scalar (OpenAPI 3.1)")
