// main.fitz — entry point del boilerplate api-postgres-python.
//
// Estructura del proyecto (módulos Fitz):
//   src/
//   ├── main.fitz                ← (este archivo) handlers HTTP
//   ├── types/
//   │   ├── user.fitz            ← `type User` (mirror SQLAlchemy)
//   │   └── api.fitz             ← `type NewUser` (body POST)
//   └── data/
//       └── users.fitz           ← wrapper Fitz sobre python/db.py
//
// El loader de módulos resuelve imports primero relativos al
// archivo importer, después relativos al "import root" (parent del
// entry file). Eso habilita que `data/users.fitz` haga `from
// types.user import User` y resuelva a `src/types/user.fitz` —
// fix de la deuda R.bug-loader-relative-only (CERRADO 2026-05-22,
// mini-fase loader-absoluto del lenguaje).

from python import json
from types.user import User
from types.api import NewUser
from data.users import create, find, list_all, init_schema

@server(3000, "0.0.0.0")
fn main() => 0

// Init de la DB en boot — crea tablas si no existen. Si falla
// (Postgres no levantó aún, credenciales mal, etc.), printeamos
// el error y seguimos arrancando — el primer request al API va
// a fallar con detalle del error de SQLAlchemy. Eso es preferible
// a un boot que cuelga indefinidamente esperando la DB.
match init_schema() {
    Ok(_)  => print("[boot] DB conectada y schema inicializado"),
    Err(e) => print("[boot] ERROR conectando a la DB — {e}"),
}

// POST /users — crear un user nuevo. El body se deserializa
// automático a `NewUser` (Fitz valida el shape). El `?` propaga
// errores SQLAlchemy (commit, conexión, etc.) → 500 con
// `{"error": "..."}`.
@post("/users")
fn create_user(body: NewUser) -> Result<User> {
    return create(body.name, body.email)
}

// GET /users/{id} — buscar por id. Si no existe, propaga el
// NoResultFound de SQLAlchemy como `Err`.
@get("/users/{id}")
fn get_user(id: Int) -> Result<User> {
    return find(id)
}

// GET /users — listar todos. Devuelve `List<User>` tipado.
@get("/users")
fn list_users() -> Result<List<User>> {
    return list_all()
}

print("[ready] Server arrancando en :3000")
print("[ready] Endpoints:")
print("[ready]   POST /users       — crear (body JSON: name, email)")
print("[ready]   GET  /users       — listar (List<User> tipado)")
print("[ready]   GET  /users/<id>  — buscar por id (User tipado)")
print("[ready]   GET  /docs        — UI Scalar (OpenAPI 3.1)")
