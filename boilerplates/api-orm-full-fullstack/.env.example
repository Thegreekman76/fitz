# Variables para docker-compose. Copiar como `.env` y editar si querés
# credenciales custom.
#
#   cp .env.example .env

POSTGRES_USER=fitz
POSTGRES_PASSWORD=fitz
POSTGRES_DB=fitz

# **Cambiar en producción**. El default es solo para que el ejemplo
# arranque sin setup extra.
JWT_SECRET=demo-fullstack-secret-cambiame-en-prod

# El cron job @daily de cleanup_old_drafts borra drafts más viejos
# que esta cantidad de días.
MAX_DRAFTS_AGE_DAYS=30
