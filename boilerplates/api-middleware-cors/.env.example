# Variables de entorno del boilerplate (todavía NO usadas porque
# Fitz no soporta `env("KEY")` builtin — deuda futura del lenguaje).
#
# Cuando Fitz lo soporte, mover el `let SECRET = "..."` de
# main.fitz a `let SECRET = env("JWT_SECRET")`. Mientras tanto,
# el secret va hardcoded en src/main.fitz — editalo antes de
# cualquier deploy real.
#
# Setup:
#   cp .env.example .env
#   # editar .env con tus valores
#
# El `.env` está en .gitignore y .dockerignore.

# JWT secret (mínimo 32 chars recomendado por seguridad).
# El default del boilerplate es UN PLACEHOLDER PÚBLICO; cambialo.
JWT_SECRET=cambiame-secreto-largo-y-aleatorio-32-chars-min

# Puertos exposed por docker-compose (overrides al yml si querés).
# API_PORT=3000
# FRONTEND_PORT=8080
