// api-middleware-cors boilerplate — API con auth nativa (JWT +
// Argon2), middleware logger custom, y CORS configurado para un
// frontend separado en otro origin.
//
// Demuestra:
//   - `@auth_provider` singleton + `@authenticated` por handler
//     (Fase 9.w.1).
//   - `jwt.encode/decode` + `hash.password/verify` built-ins.
//   - `@middleware(fn)` custom apilable (logger).
//   - `@middleware(cors({...}))` con preflight OPTIONS automático
//     + headers `Access-Control-Allow-*` inyectados en cada
//     response.
//   - Status codes custom con `return 401 { ... }`.
//   - OpenAPI 3.1 + UI Scalar auto-documentando el bearerAuth +
//     respuestas 401.
//
// Stack del boilerplate:
//   - API Fitz en `:3000` (este programa).
//   - Frontend HTML+JS vanilla en `:8080` (nginx alpine, otro
//     container del docker-compose).
//   - CORS habilita requests cross-origin del frontend al API.
//
// Endpoints:
//   - POST /login      — público con CORS; valida creds, devuelve JWT.
//   - GET  /me         — @authenticated; devuelve el user del JWT.
//   - GET  /items      — público con CORS; data hardcoded.
//   - GET  /openapi.json + /docs — auto-generados.

@server(3000, "0.0.0.0")
fn main() => 0

// JWT secret leído de la env var `JWT_SECRET` con fallback a un
// valor demo (32+ chars para HS256). Para producción real: setear
// `JWT_SECRET` con un valor fuerte generado aleatoriamente — vía
// docker-compose env, .env file con `load_env(...)`, secrets de
// Kubernetes, etc. El builtin `env_or(key, default)` devuelve `Str`
// directamente (mini-fase env builtin 2026-05-22).
let SECRET = env_or("JWT_SECRET", "demo-secret-cambiame-antes-de-deploy-32-chars-min")

type User { id: Int, email: Str, name: Str, role: Str }
type Credentials { email: Str, password: Str }
type LoginResponse { token: Str }

// "Base de datos" mínima — hashes generados al boot.
let ADA_HASH = hash.password("secret-ada-123")

// Middleware logger — corre antes de CADA request decorada con él.
// Recibe `Request` (built-in con method/path/headers); si retorna
// `null` o sin return, la chain continúa al handler. Si retornara
// `return <status> { ... }`, short-circuitea la response (gate-only).
fn log_request(req: Request) -> Null {
    print("[{req.method}] {req.path}")
    return null
}

// Provider de auth — singleton. Corre antes de CADA request
// `@authenticated`. Si devuelve `Err(...)`, el handler NO se ejecuta
// y el client recibe 401 automático.
@auth_provider
fn check_token(headers: Map<Str, Str>) -> Result<User> {
    let auth: Str = match headers.get("authorization") {
        Ok(v) => v,
        Err(_) => return Err("falta header Authorization"),
    }
    let parts = auth.split(" ")
    if (parts.len() != 2) { return Err("Authorization debe ser 'Bearer <token>'") }
    if (parts[0] != "Bearer") { return Err("scheme debe ser Bearer") }
    let claims = jwt.decode(parts[1], SECRET)?
    return Ok(User { id: 1, email: claims["email"], name: "Ada", role: "user" })
}

// POST /login — único endpoint que el frontend usa sin token.
// Verifica password con `hash.verify` (Argon2id), emite JWT firmado.
// CORS habilitado: el frontend en :8080 hace fetch a :3000.
@middleware(log_request)
@middleware(cors({"allow_origin": "http://localhost:8080", "allow_methods": ["POST", "OPTIONS"], "allow_headers": ["Content-Type"]}))
@post("/login")
fn login(creds: Credentials) -> LoginResponse {
    if (creds.email != "ada@example.com") {
        return 401 { "error": "credenciales inválidas" }
    }
    if (not hash.verify(creds.password, ADA_HASH)) {
        return 401 { "error": "credenciales inválidas" }
    }
    let claims = { "email": creds.email, "role": "user" }
    let token = jwt.encode(claims, SECRET)
    return LoginResponse { token: token }
}

// GET /me — protegido. El runtime corre `check_token` con los
// headers, si pasa inyecta el `user` resuelto como arg del handler.
// CORS habilita el GET cross-origin + el header `Authorization`.
@middleware(log_request)
@middleware(cors({"allow_origin": "http://localhost:8080", "allow_methods": ["GET", "OPTIONS"], "allow_headers": ["Authorization"]}))
@authenticated
@get("/me")
fn me(user: User) -> User => user

// GET /items — público (sin @authenticated) — el frontend lo llama
// sin token. CORS habilita el GET cross-origin.
@middleware(log_request)
@middleware(cors({"allow_origin": "http://localhost:8080", "allow_methods": ["GET", "OPTIONS"]}))
@get("/items")
fn items() -> List<Str> => ["widget", "gadget", "thingamajig"]
